+// Our FNAF touch overlay is a native Android View, so Vulkan must not call
+// MobileTouchControls' OpenGL drawing. It still needs the per-frame input tick.
+void FnafMobileVulkanFrame(void)
+{
+    touchInterface.newGameFrame();
+    game_finished_load = true;
+    static bool reported = false;
+    if (!reported) {
+        reported = true;
+        LOGI("FNAF_NATIVE_VULKAN_FIRST_FRAME");
+        Android_JNI_SendMessage(0x8015, 1);
+    }
+}
+

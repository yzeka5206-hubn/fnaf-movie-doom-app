+void IQMModel::BuildFnafCullBounds()
+{
+	// No assumptions about actor collision dimensions, static frame bounds,
+	// or animation names. Include every vertex in each bone that affects it.
+	// Weighted positions in the shader are convex combinations of these boxes.
+	fnafCullBoundsValid = false;
+	const int count = Joints.SSize();
+	if (count <= 0 || count > 256 || Vertices.Size() == 0) return;
+	bool pos = false, selectors = false, weights = false;
+	for (const IQMVertexArray& a : VertexArrays)
+	{
+		pos |= a.Type == IQM_POSITION;
+		selectors |= a.Type == IQM_BLENDINDEXES;
+		weights |= a.Type == IQM_BLENDWEIGHTS;
+	}
+	if (!pos || !selectors || !weights) return;
+	fnafBoneBounds.Clear();
+	fnafBoneBounds.Resize(count);
+	fnafUnweightedBounds = {};
+	for (const FModelVertex& v : Vertices)
+	{
+		// Some material passes or GPU fallbacks may draw the unskinned bind
+		// pose. Include every original vertex as well as animated bone boxes,
+		// so neither path can be rejected while its geometry is visible.
+		if (!fnafUnweightedBounds.Add(v.x, v.y, v.z)) return;
+		for (int i = 0; i < 4; ++i)
+		{
+			if (!v.boneweight[i]) continue;
+			int joint = v.boneselector[i];
+			if (joint >= count || !fnafBoneBounds[joint].Add(v.x, v.y, v.z)) return;
+		}
+	}
+	fnafCullBoundsValid = true;
+}

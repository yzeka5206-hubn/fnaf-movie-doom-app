version "4.12.0"

// Adapter for Android touch input. Uses the original game's character selector
// and the engine's own menus, and never generates a gameplay mouse click.
class FnafDirectTouchHandler : StaticEventHandler
{
    ui int fnafSession;
    ui int fnafLastMode;
    ui bool fnafPublished;
    ui int fnafClickTicks;
    // Keep synthetic menu mouse events out of gameplay until Android has
    // acknowledged the current gameplay state. The overlay may learn about
    // a closed menu a fraction of a second after the engine itself.
    ui bool fnafMouseGuard;
    ui int fnafBackX;
    ui int fnafBackY;
    ui int fnafBackW;
    ui int fnafBackH;
    ui int fnafScreenW;
    ui int fnafScreenH;

    ui MouseDriverHandler FnafDriver()
    {
        return MouseDriverHandler(StaticEventHandler.Find('MouseDriverHandler'));
    }

    // 0 = gameplay, 1 = the game's character selection, 2 = engine menu.
    ui int FnafMode()
    {
        if (menuactive != Menu.Off) return 2;
        let driver = FnafDriver();
        if (driver && driver.IsMenuOpen()) return 1;
        return 0;
    }

    ui void FnafPublishMode(bool force)
    {
        int mode = FnafMode();
        int x = 0, y = 0, w = 0, h = 0, sw = 0, sh = 0;
        if (mode == 2)
        {
            sw = screen.GetWidth();
            sh = screen.GetHeight();
            if (m_show_backbutton >= 0)
            {
                let tex = TexMan.CheckForTexture(gameinfo.mBackButton, TexMan.Type_MiscPatch);
                if (tex.IsValid())
                {
                    Vector2 size = TexMan.GetScaledSize(tex);
                    w = int(size.x + 0.5) * CleanXfac;
                    h = int(size.y + 0.5) * CleanYfac;
                    x = (m_show_backbutton & 1) ? sw - w : 0;
                    y = (m_show_backbutton & 2) ? sh - h : 0;
                }
            }
        }
        if (fnafSession && (force || !fnafPublished || fnafLastMode != mode ||
            fnafBackX != x || fnafBackY != y || fnafBackW != w || fnafBackH != h ||
            fnafScreenW != sw || fnafScreenH != sh))
        {
            // Include the engine's exact back-button bounds in screen space.
            // Android maps them through the letterbox before intercepting taps.
            Console.PrintfEx(PRINT_LOG, "FNAF_TOUCH_STATE:%d:%d:%d:%d:%d:%d:%d:%d",
                fnafSession, mode, x, y, w, h, sw, sh);
            fnafLastMode = mode;
            fnafBackX = x; fnafBackY = y; fnafBackW = w; fnafBackH = h;
            fnafScreenW = sw; fnafScreenH = sh;
            fnafPublished = true;
        }
    }

    override void UiTick()
    {
        FnafPublishMode(false);
        if (FnafMode() == 2)
        {
            BackbuttonTime = 4 * GameTicRate;
            fnafMouseGuard = true;
        }
        if (fnafClickTicks > 0)
        {
            if (FnafMode() != 1) fnafClickTicks = 0;
            else if (--fnafClickTicks == 0)
            {
                // ACS updates selection/hover every four tics; position first.
                EventHandler.SendNetworkEvent("NetClick");
            }
        }
    }

    override void InterfaceProcess(ConsoleEvent e)
    {
        if (e.Name ~== "FnafTouchPing")
        {
            fnafSession = e.Args[0];
            FnafPublishMode(true);
            return;
        }
        if (e.Name ~== "FnafTouchAck")
        {
            if (e.Args[0] == fnafSession && fnafSession && e.Args[1] == 0 && FnafMode() == 0)
                fnafMouseGuard = false;
            return;
        }
        if (!(e.Name ~== "FnafTouch")) return;
        FnafHandleTouch(e.Args[0], e.Args[1], e.Args[2]);
    }

    ui void FnafHandleTouch(int rawX, int rawY, int phase)
    {
        int nx = clamp(rawX, 0, 65535);
        int ny = clamp(rawY, 0, 65535);
        // phase: 0 down, 1 move, 2 up, 3 cancel
        int mode = FnafMode();
        if (mode == 1)
        {
            let driver = FnafDriver();
            if (!driver) return;
            if (phase == 3) { fnafClickTicks = 0; return; }
            if (phase == 0) fnafClickTicks = 0;
            driver.mPos = (nx, ny);
            driver.initialized = true;
            EventHandler.SendNetworkEvent("NetMouse", nx, ny);
            if (phase == 2) fnafClickTicks = 4;
            return;
        }

    }

    override bool InputProcess(InputEvent e)
    {
        // Only relevant during a menu-to-game transition. Ordinary gameplay
        // and hardware mice regain their bindings after Android acknowledges.
        if (fnafMouseGuard && FnafMode() != 2 &&
            (e.Type == InputEvent.Type_KeyDown || e.Type == InputEvent.Type_KeyUp) &&
            (e.KeyScan == InputEvent.Key_Mouse1 || e.KeyScan == InputEvent.Key_Mouse4 ||
             e.KeyScan == InputEvent.Key_MWheelUp ||
             e.KeyScan == InputEvent.Key_MWheelDown))
            return true;
        return false;
    }
}

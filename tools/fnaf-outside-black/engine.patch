+
+static bool FnafExteriorPortalSpan(FLevelLocals *level, FLinePortalSpan *span)
+{
+    if (!level || !span || span->lines.Size() == 0) return false;
+    // Fail open if any member of a merged span is not a known outdoor portal.
+    for (unsigned i = 0; i < span->lines.Size(); ++i)
+    {
+        auto portal = span->lines[i];
+        if (!portal || !portal->mOrigin || !portal->mDestination) return false;
+        auto src = portal->mOrigin;
+        auto dst = portal->mDestination;
+        if (!src->v1 || !src->v2 || !dst->v1 || !dst->v2) return false;
+        if (!FnafOutsideBlack::ExteriorPortal(level->MapName.GetChars(),
+            level->GetFirstLineId(src), level->GetFirstLineId(dst),
+            (src->v1->fX() + src->v2->fX()) * 0.5, (src->v1->fY() + src->v2->fY()) * 0.5,
+            (dst->v1->fX() + dst->v2->fX()) * 0.5, (dst->v1->fY() + dst->v2->fY()) * 0.5)) return false;
+    }
+    return true;
+}
 

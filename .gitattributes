# Buyuk oyun dosyalari Git LFS ile saklanir (GitHub'in 100 MB dosya siniri icin)
doom/src/main/assets/game/*.pk3 filter=lfs diff=lfs merge=lfs -text
doom/src/main/assets/game/*.wad filter=lfs diff=lfs merge=lfs -text
doom/src/main/assets/game/*.ipk3 filter=lfs diff=lfs merge=lfs -text
# Small, reproducible addons are ordinary Git data, not LFS objects.
doom/src/main/assets/game/fnaf-touch-v1.pk3 -filter -diff -merge -text
doom/src/main/assets/game/fnaf-model-static-v1.pk3 -filter -diff -merge -text
doom/src/main/assets/game/fnaf-model-frames-v1.pk3 -filter -diff -merge -text
